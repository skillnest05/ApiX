# ==============================================================================
# APIx Platform Configuration Template (.env.example)
# Copy this file to .env and configure environment variables before deployment.
# ==============================================================================

# Application Environment ('production', 'staging', 'development')
APIX_ENV=production

# Debug Mode (Keep false in production)
APIX_DEBUG=false

# Server Network Interface & Port
APIX_HOST=0.0.0.0
APIX_PORT=8000

# Database Connection URL
# SQLite Default (Local Development / Single-node):
APIX_DATABASE_URL=sqlite:///apix.db
# PostgreSQL (Production Cloud / Clustered deployment):
# APIX_DATABASE_URL=postgresql+psycopg2://apix_user:StrongPassword123@db-host:5432/apix_db

# Institutional API Authentication Key
# If set, clients must pass this token via 'X-API-Key' or 'Authorization: Bearer <token>'
# Leave empty for open public/internal access
APIX_API_KEY=

# Cryptographic Secret Key (Used for session integrity & CSRF protection)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APIX_SECRET_KEY=replace-with-a-random-64-character-hex-secret-in-production

# Cross-Origin Resource Sharing (CORS) Whitelist (Comma-separated)
APIX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000

# DoS & Abuse Protection: Client IP Rate Limit (Requests per minute)
APIX_RATE_LIMIT_PER_MINUTE=120

# OWASP Security Headers (HSTS, CSP, X-Frame-Options, X-Content-Type-Options)
APIX_SECURE_HEADERS=true

# Interactive API Documentation (/docs, /redoc)
# Recommended: false in high-security production, true for staging and internal evaluation
APIX_ENABLE_DOCS=true
